# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
# Clerk Publishable Key (used by React client-side)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Backend API URL (used by React frontend to call Express API)
VITE_API_BASE_URL=http://localhost:5000

# ==============================================================================
# BACKEND SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# MONGODB DATABASE
# ==============================================================================
# Local MongoDB or MongoDB Atlas connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/ai-resume-generator

# ==============================================================================
# CLERK AUTHENTICATION (BACKEND SECRETS)
# ==============================================================================
# Clerk Secret Key (starts with sk_test_... or sk_live_...) - NEVER expose to frontend
CLERK_SECRET_KEY=sk_test_placeholder_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# ==============================================================================
# GROQ AI INFERENCE
# ==============================================================================
# Groq API Key (starts with gsk_...) - server-side only
GROQ_API_KEY=gsk_placeholder_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
